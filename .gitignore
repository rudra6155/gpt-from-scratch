__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
build/
dist/

# raw data + token caches are regenerated by `make data`
data/tinyshakespeare/

# resumable training checkpoints (with optimizer state) are large; only the
# exported weights-only checkpoint artifacts/checkpoints/tiny.pt is committed
artifacts/runs/
artifacts/checkpoints/*
!artifacts/checkpoints/tiny.pt
